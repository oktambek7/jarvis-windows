# ---- Gemini Live (required) ----
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Aisha AI (optional, only if you flip tts.backend to "aisha") ----
# An Uzbek-trained voice. Better accent than Gemini's multilingual voice, but
# adds 1.5-3s per reply and removes barge-in. Try "gemini" first.
# https://aisha.group -> dashboard -> API key
AISHA_API_KEY=

# ---- Telegram (optional, enables send_telegram_message) ----
# Lets Jarvis send Telegram messages to your contacts as YOU (not a bot), via
# the official MTProto API. Get a free api_id/api_hash at
# https://my.telegram.org/apps, paste them below, then run once:
#   python -m jarvis --telegram-login
# That logs in interactively (phone number + the code Telegram texts you) and
# saves a session file so Jarvis never has to ask again.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Custom model (optional, enables delegate_to_custom_model) ----
# API key for whatever OpenAI-compatible endpoint you point custom_model.
# base_url at in config.yaml. Rename this if you set a different
# custom_model.api_key_env there.
CUSTOM_MODEL_API_KEY=
